rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && (request.auth.uid == 'dTxIE4YXaNSlwLS2Qdd2Q3ynBtH2' || exists(/databases/$(database)/documents/admins/$(request.auth.uid))); }

    match /commandProposals/{proposalId} {
      allow create: if request.resource.data.status == 'pending' && request.resource.data.label is string && request.resource.data.command is string && request.resource.data.description is string && request.resource.data.warning is string && request.resource.data.label.size() > 0 && request.resource.data.command.size() > 0 && request.resource.data.description.size() > 0 && request.resource.data.warning.size() > 0 && request.resource.data.command.size() <= 2000;
      allow read: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /commands/{commandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
